# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your live address, used for sign-in links and sharing previews
NEXT_PUBLIC_SITE_URL=https://www.pheelm.com

# Optional: TMDB fills posters, synopses, cast and crew, trailers and where to watch.
# Free at themoviedb.org > Settings > API. Either the API Key or the Read Access Token works.
# TMDB_API_KEY=
# Countries whose streaming options are imported (default US,GB,FR,CA)
# TMDB_WATCH_REGIONS=US   (one country: film pages show one country's streaming options)

# Optional: show "Continue with Google" on the sign-in page
# NEXT_PUBLIC_ENABLE_GOOGLE=true

# Early access: signed-out visitors only see the home page and pages about Pheelm.
# Set to off at public launch (then redeploy). See lib/launch.ts.
# NEXT_PUBLIC_EARLY_ACCESS=off

# Contact and social links shown in the footer and on the Contact page. Leave empty to hide.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@pheelm.com
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yourhandle
# NEXT_PUBLIC_THREADS_URL=https://www.threads.net/@yourhandle

# Server-only keys. Never use NEXT_PUBLIC_ for them.
# The service role key runs the admin's background jobs (film queue, TMDB backfills, poster colours,
# awards) and a few admin and form actions. The OpenAI key is only for writing director biographies (Admin > Automation);
# moderation uses Pheelm's own banned-word list and needs no key (see docs/moderation.md).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OPENAI_API_KEY=

# Optional: Cloudflare Turnstile spam check on the contact and newsletter forms. Both are needed.
# The site key is public. Keep the secret key in your host's secret settings, never in this file.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAF9HLUk2vjOX0Gdk
# TURNSTILE_SECRET_KEY=

# Optional: error reporting with Sentry. Reports are sent from the live site only; the project address is in lib/sentry-scrub.ts.
# For readable stack traces, add this in Vercel (Production, secret). Create it in Sentry > Settings > Auth Tokens.
# SENTRY_AUTH_TOKEN=

# Donations go through PayPal (no Stripe keys needed). Where members change or cancel a monthly gift:
# NEXT_PUBLIC_DONATION_PORTAL_URL=https://www.paypal.com/myaccount/autopay/

# Optional: PayPal hosted Donate button id for the Donate page (default is Pheelm's). Empty hides it.
# NEXT_PUBLIC_PAYPAL_BUTTON_ID=CDST4QBEP4AYA
