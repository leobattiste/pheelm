# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your live address, used for sign-in links and sharing previews
NEXT_PUBLIC_SITE_URL=https://pheelm.vercel.app

# Optional: TMDB fills posters, synopses, cast and crew, trailers and where to watch.
# Free at themoviedb.org > Settings > API. Either the API Key or the Read Access Token works.
# TMDB_API_KEY=
# Countries whose streaming options are imported (default US,GB,FR,CA)
# TMDB_WATCH_REGIONS=US   (one country: film pages show one country's streaming options)

# Optional: show "Continue with Google" on the sign-in page
# NEXT_PUBLIC_ENABLE_GOOGLE=true
